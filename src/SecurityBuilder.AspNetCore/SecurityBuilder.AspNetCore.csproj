<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Wires SecurityBuilder into ASP.NET Core: dependency injection, the middleware that signs the current user in from role claims, ICurrentUser, and AccessDeniedException as 403 ProblemDetails.</Description>
    <PackageTags>$(PackageTags);aspnetcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The core only. The EF Core integration is wired separately through UseSecurity. -->
    <ProjectReference Include="..\SecurityBuilder\SecurityBuilder.csproj" />
  </ItemGroup>

</Project>
